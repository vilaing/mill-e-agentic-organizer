# Copy this file to .env and fill in your values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-api...

# Paths (defaults are usually fine)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
DB_PATH=data/student_agent.db

# Model to use for the agent loop
CLAUDE_MODEL=claude-sonnet-5

# Public demo mode (per-visitor sandboxes, simulated Gmail/Calendar, usage caps).
# Leave false for personal use. The Docker image sets it to true.
DEMO_MODE=false
DEMO_MESSAGES_PER_VISITOR=20
DEMO_MESSAGES_PER_DAY=200

# Optional "Sign in with Google" for the hosted demo (Web application OAuth client).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.fly.dev/api/auth/google/callback
